{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roundnetmobile",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "roundnetmobile-assets"
    }
  ],
  "routes": [
    {
      "pattern": "roundnetmobile.calebely.com",
      "custom_domain": true
    }
  ]
}
